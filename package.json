{
  "name": "cubevision",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "CubeVision Phase 0 - technical validation harness",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures": "GEN_FIXTURES=1 vitest run tests/fixtures.gen.test.ts",
    "sweep": "SWEEP=1 vitest run tests/sweep.test.ts",
    "video": "GEN_VIDEO=1 vitest run tests/video.gen.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
