{
  "name": "cubevision",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CubeVision - カメラで普通のルービックキューブの回転を追跡して画面に再現するアプリ",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "cubing": "^0.66.1",
    "mp4box": "^2.4.1",
    "preact": "^11.0.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
